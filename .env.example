# Configure these with credentials for this store's own PostgreSQL database.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/BARAA_STORE?schema=public"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/BARAA_STORE?schema=public"

# Generate a unique secret for this store. Never copy a value from another store.
AUTH_SECRET="replace-with-a-unique-random-secret-of-at-least-32-characters"

# Optional one-time, process-only admin bootstrap values. Do not save these in .env.
# ADMIN_BOOTSTRAP_EMAIL=
# ADMIN_BOOTSTRAP_PASSWORD=

# Optional demo catalog seed. Enable only against a disposable non-production database.
# SEED_DEMO_DATA=true
