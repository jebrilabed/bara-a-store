{
  "name": "baraa-store",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate --schema prisma/schema.prisma",
    "dev": "prisma generate && next dev apps/web",
    "build": "prisma generate && next build apps/web",
    "start": "next start apps/web",
    "typecheck": "tsc --noEmit --project apps/web/tsconfig.json",
    "test:backend": "node --test --test-isolation=none apps/web/tests/*.test.mjs",
    "db:validate": "prisma validate --schema prisma/schema.prisma",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:migrate:status": "prisma migrate status --schema prisma/schema.prisma",
    "db:seed": "prisma db seed",
    "admin:bootstrap": "tsx scripts/bootstrap-admin.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "5.20.0",
    "bcryptjs": "2.4.3",
    "cloudinary": "^2.11.0",
    "lucide-react": "^1.57.0",
    "next": "14.2.15",
    "next-auth": "5.0.0-beta.25",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "20.16.10",
    "@types/react": "18.3.11",
    "prisma": "5.20.0",
    "tsx": "4.19.1",
    "typescript": "5.6.2"
  }
}